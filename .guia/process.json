{
  "schemaVersion": 1,
  "name": "guia-fluxo",
  "projectName": "guia-fluxo",
  "ids": {
    "featurePrefix": "F",
    "issuePrefix": "I",
    "backlogPrefix": "B",
    "digits": 3
  },
  "chatTitleFormat": "{id} {kindMarker} - #{statusTag} - {title}",
  "ready": {
    "status": "Aguardando validacao",
    "runValidationByDefault": false,
    "validationCommands": []
  },
  "finish": {
    "status": "Validada",
    "runValidationByDefault": false,
    "validationCommands": [],
    "commitByDefault": true,
    "lockOnFinish": false
  },
  "validate": {
    "status": "Validada",
    "deprecatedAliasFor": "finish --no-commit",
    "lockOnValidate": false
  },
  "archive": {
    "keepInDemandas": 30
  },
  "delivery": {
    "mode": "pr",
    "commit": {
      "format": "gitmoji-conventional",
      "coAuthor": "Claude Opus 5.5 <noreply@anthropic.com>"
    },
    "changelog": {
      "style": "fragments",
      "dir": "changelog.d"
    },
    "gate": {
      "full": [
        "python -m pytest -q",
        "python core/build/render-skills.py --check"
      ]
    },
    "pr": {
      "footer": "🤖 Generated with [Claude Code](https://claude.com/claude-code)"
    }
  },
  "skills": {
    "quality": [
      "clean-code-review",
      "clean-architecture-guardian"
    ]
  }
}
