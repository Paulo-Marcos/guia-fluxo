+def ler_fragmentos() -> dict[str, str]:
+    pasta = RAIZ / PASTA_DE_FRAGMENTOS
+    if not pasta.is_dir():
+        return {}
+    return {
+        arquivo.name: arquivo.read_text(encoding="utf-8")
+        for arquivo in sorted(pasta.glob("*.md"))
+        if arquivo.name.lower() != "readme.md"
+    }
